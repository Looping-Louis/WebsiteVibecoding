PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:4200
DATABASE_URL=postgres://postgres:postgres@localhost:5432/website_vibecoding
DATABASE_SSL=false
# Set to false ONLY for local dev with self-signed certs. Must be true in production.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# REQUIRED: Generate with: openssl rand -hex 32
# Must be at least 32 characters. Never use the placeholder value in production.
JWT_SECRET=REPLACE-THIS-WITH-A-SECURE-RANDOM-64-CHAR-SECRET
JWT_EXPIRES_IN_HOURS=8
INITIAL_USER_EMAIL=demo@ai.local
# REQUIRED: Set a strong unique password before deployment. Never use the placeholder value.
INITIAL_USER_PASSWORD=REPLACE-THIS-WITH-A-STRONG-RANDOM-PASSWORD
INITIAL_USER_DISPLAY_NAME=Demo User
ALLOW_REGISTRATION=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_VECTOR_STORE_ID=
